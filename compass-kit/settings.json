{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/secrets-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
